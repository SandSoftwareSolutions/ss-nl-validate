{
  "name": "@sandsoftwaresolutions/nl-validate",
  "version": "0.1.1",
  "description": "Check Dutch BSN, IBAN, KvK, VAT number, postcode and phone numbers. One small function each.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "nl",
    "dutch",
    "iban",
    "bsn",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-nl-validate.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-nl-validate/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-nl-validate#readme",
  "publishConfig": {
    "access": "public"
  }
}
